{
    "name": "syriable/laravel-translation",
    "description": "Translations for Filament and Livewire UI copy: identifiers in PHP, copy in language files.",
    "keywords": [
        "syriable",
        "laravel",
        "filament",
        "livewire",
        "translation",
        "i18n",
        "l10n",
        "message-catalog",
        "filament-translation"
    ],
    "homepage": "https://github.com/syriable/filament-auto-translator",
    "license": "MIT",
    "authors": [
        {
            "name": "Syriable",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/framework": "^13.23",
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^5.1",
        "laravel/pint": "^1.27",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Syriable\\Translation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Syriable\\Translation\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Syriable\\Translation\\TranslationServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --compact"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
{
    "name": "syriable/filament-auto-translator",
    "description": "A Filament plugin that fills labels, headings and other UI copy from your language files, so PHP keeps only machine names.",
    "keywords": [
        "syriable",
        "filament",
        "filament-plugin",
        "laravel",
        "livewire",
        "translation",
        "localization",
        "i18n"
    ],
    "homepage": "https://github.com/syriable/filament-auto-translator",
    "support": {
        "issues": "https://github.com/syriable/filament-auto-translator/issues",
        "source": "https://github.com/syriable/filament-auto-translator"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Syriable",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/framework": "^13.23",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Syriable\\Filament\\Plugins\\AutoTranslator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Syriable\\Filament\\Plugins\\AutoTranslator\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Syriable\\Filament\\Plugins\\AutoTranslator\\AutoTranslatorServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --compact",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
